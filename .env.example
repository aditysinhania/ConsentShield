# ConsentShield
APP_NAME=ConsentShield
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://consentshield:consentshield@localhost:5432/consentshield
DATABASE_URL_SYNC=postgresql://consentshield:consentshield@localhost:5432/consentshield

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,chrome-extension://*

# Storage
STORAGE_ROOT=./storage
SCREENSHOTS_DIR=./storage/screenshots
REPORTS_DIR=./storage/reports

# AI / Models
MODELS_ROOT=./models
VISION_MODEL_PATH=
TEXT_MODEL_PATH=
FUSION_MODEL_PATH=
AI_STUB_MODE=true

# Phase 4 pretrained models (set AI_STUB_MODE=false to enable)
TEXT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VISION_MODEL_NAME=openai/clip-vit-base-patch32
DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
CACHE_MODELS=true
# auto | pretrained | lexical
PHASE4_BACKEND=auto

# LLM Narrator (optional — rules remain source of truth)
AI_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=

# API
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
