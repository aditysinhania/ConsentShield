# ConsentShield
APP_NAME=ConsentShield
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://consentshield:consentshield@localhost:5432/consentshield
DATABASE_URL_SYNC=postgresql://consentshield:consentshield@localhost:5432/consentshield

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,chrome-extension://*

# Storage
STORAGE_ROOT=./storage
SCREENSHOTS_DIR=./storage/screenshots
REPORTS_DIR=./storage/reports

# AI / Models
MODELS_ROOT=./models
VISION_MODEL_PATH=
TEXT_MODEL_PATH=
FUSION_MODEL_PATH=
AI_STUB_MODE=true

# API
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
